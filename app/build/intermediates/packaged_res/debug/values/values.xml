<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_light">#F8F9FA</color>
    <color name="black">#000000</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="colorAccent">#FFD600</color>
    <color name="colorCompleted">#757575</color>
    <color name="colorLive">#D32F2F</color>
    <color name="colorPrimary">#1A237E</color>
    <color name="colorPrimaryDark">#121858</color>
    <color name="colorUpcoming">#1976D2</color>
    <color name="cricket_green">#2E7D32</color>
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Cricket Match Tracker</string>
    <string name="firebase_database_url" translatable="false">https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com</string>
    <string name="gcm_defaultSenderId" translatable="false">YOUR_PROJECT_NUMBER</string>
    <string name="google_api_key" translatable="false">YOUR_API_KEY</string>
    <string name="google_app_id" translatable="false">1:YOUR_PROJECT_NUMBER:android:XXXXXXXXXXXX</string>
    <string name="google_crash_reporting_api_key" translatable="false">YOUR_API_KEY</string>
    <string name="google_storage_bucket" translatable="false">YOUR_PROJECT_ID.appspot.com</string>
    <string name="project_id" translatable="false">YOUR_PROJECT_ID</string>
    <string name="sample_overs">Overs: 20</string>
    <string name="sample_score">0/0 | 0/0</string>
    <string name="sample_teams">Team A vs Team B</string>
    <string name="status_upcoming">UPCOMING</string>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>
    <style name="ScoringButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
    </style>
    <style name="Theme.CricketMatchTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/cricket_green</item>
        <item name="colorSecondaryVariant">@color/cricket_green</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>