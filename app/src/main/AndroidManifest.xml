<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="Cricket Match Tracker"
        android:supportsRtl="true"
        android:theme="@style/Theme.CricketMatchTracker">

        <activity
            android:name=".activities.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.OrganizerDashboardActivity" />
        <activity android:name=".activities.ViewerDashboardActivity" />
        <activity android:name=".activities.CreateMatchActivity" />
        <activity android:name=".activities.PreMatchSetupActivity" />
        <activity android:name=".activities.OpeningPlayersActivity" />
        <activity android:name=".activities.LiveScoringActivity" />
        <activity android:name=".activities.ViewerScoreActivity" />
        <activity android:name=".activities.MatchResultActivity" />

    </application>

</manifest>